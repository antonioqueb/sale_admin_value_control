<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cva_apply_wizard_form" model="ir.ui.view">
        <field name="name">sale.cva.apply.wizard.form</field>
        <field name="model">sale.cva.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="Aplicar ajuste administrativo">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="scope" widget="radio"/>
                            <field name="keep_line_overrides"
                                   invisible="scope != 'order'"/>
                        </group>
                        <group>
                            <field name="quick_id" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="percent"/>
                            <field name="reason" placeholder="Motivo o referencia interna del ajuste"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vista previa por línea" name="preview">
                            <field name="line_ids" readonly="scope != 'lines'">
                                <list create="false" delete="false" editable="bottom">
                                    <field name="selected" widget="boolean_toggle"
                                           column_invisible="parent.scope != 'lines'"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="name" readonly="1" optional="hide"/>
                                    <field name="qty" readonly="1"/>
                                    <field name="price_unit_ref" readonly="1"/>
                                    <field name="percent_current" readonly="1"/>
                                    <field name="has_override" readonly="1" optional="hide"/>
                                    <field name="subtotal_adm_current" readonly="1"/>
                                    <field name="percent_new" readonly="1" decoration-info="1"/>
                                    <field name="subtotal_adm_new" readonly="1" decoration-info="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="line_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="total_ref"/>
                        <field name="total_adm_current"/>
                        <field name="total_adm_new" class="oe_subtotal_footer_separator"/>
                        <field name="diff_new"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirmar aplicación" name="action_confirm"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
