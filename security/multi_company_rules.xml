<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_cva_history_company" model="ir.rule">
            <field name="name">Historial CVA: multiempresa</field>
            <field name="model_id" ref="model_sale_cva_history"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_cva_quick_percent_company" model="ir.rule">
            <field name="name">Porcentajes rápidos CVA: multiempresa</field>
            <field name="model_id" ref="model_sale_cva_quick_percent"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
