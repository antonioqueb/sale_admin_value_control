<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cash_receipt_view_form_cva" model="ir.ui.view">
        <field name="name">cash.receipt.form.cva</field>
        <field name="model">cash.receipt</field>
        <field name="inherit_id" ref="cash_receipt_voucher.cash_receipt_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" role="alert"
                     groups="sale_admin_value_control.group_cva_manager"
                     invisible="not x_cva_lens_on">
                    <strong>VISTA ADMINISTRATIVA:</strong> el monto del recibo se
                    muestra (y se imprime) con el ajuste administrativo de sus
                    pedidos. El recibo conserva su importe operativo.
                </div>
                <field name="x_cva_lens_on" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
